<?php
/**
 * Скрипт обработки уведомлений от Робокассы (ResultURL)
 * Этот скрипт вызывается Робокассой после успешного платежа
 * и отправляет уведомление о платеже на вебхук
 */

// Включаем вывод всех ошибок для отладки
ini_set('display_errors', 1);
error_reporting(E_ALL);

// Параметры Робокассы
$mrh_login = "zrussa";
$mrh_pass2 = "B66SZ5ZWBkTN2mYFuPn9"; // Пароль #2 для проверки уведомлений

// Получаем параметры от Робокассы
$out_summ = isset($_REQUEST["OutSum"]) ? $_REQUEST["OutSum"] : "";
$inv_id = isset($_REQUEST["InvId"]) ? $_REQUEST["InvId"] : "";
$signature = isset($_REQUEST["SignatureValue"]) ? $_REQUEST["SignatureValue"] : "";

// Записываем все полученные параметры для отладки
$debug_log_file = __DIR__ . '/payment_debug_log.txt';
$debug_data = date('Y-m-d H:i:s') . " | Полученные параметры: " . json_encode($_REQUEST, JSON_UNESCAPED_UNICODE) . "\n";
file_put_contents($debug_log_file, $debug_data, FILE_APPEND);

// Формируем строку для проверки подписи
$crc = strtoupper(md5("$out_summ:$inv_id:$mrh_pass2"));

// Проверяем подпись
if (strtoupper($signature) !== $crc) {
    echo "bad sign";
    exit;
}

// Получаем email из параметров
$email = isset($_REQUEST["EMail"]) ? $_REQUEST["EMail"] : "не указан";

// Получаем дополнительные параметры, если они были переданы
$description = isset($_REQUEST["Description"]) ? $_REQUEST["Description"] : "Заказ без описания";

// Формируем данные для отправки на вебхук
$webhook_data = [
    'name' => '',
    'email' => $email,
    'phone' => '',
    'address' => '',
    'comment' => '',
    'paymentMethod' => 'robokassa',
    'deliveryMethod' => '',
    'totalSum' => $out_summ,
    'products' => [],
    'payment_status' => 'paid',
    'payment_date' => date('Y-m-d H:i:s')
];

// URL вебхука для уведомления об оплаченных заказах
$webhook_url = 'https://hook.eu2.make.com/mjab95ygp4snnrhm17wx1thexcjfcunm';

// Отправляем данные на вебхук
$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $webhook_url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($webhook_data));
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    'Content-Type: application/json'
]);

$response = curl_exec($ch);
$curl_error = curl_error($ch);
curl_close($ch);

// Записываем информацию о платеже и результат отправки вебхука в лог-файл
$log_file = __DIR__ . '/payment_log.txt';
$log_data = date('Y-m-d H:i:s') . " | Сумма: $out_summ | Email: $email | Отправленные данные: " . json_encode($webhook_data, JSON_UNESCAPED_UNICODE) . " | Webhook ответ: $response | Ошибка CURL: $curl_error\n";
file_put_contents($log_file, $log_data, FILE_APPEND);

// Возвращаем ответ Робокассе
echo "OK$inv_id";
